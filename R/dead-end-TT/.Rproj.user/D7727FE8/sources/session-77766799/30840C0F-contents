urban_sol$n_class <- urban_sol %>% pull(eval(parse(text=urban_seg)))

urban_tt_vars <- vulnerability_vars_tt %>%
  dplyr::filter(typing_tool_strata %in% c("both", "all", stratum)) %>%
  dplyr::select(vulnerability_variable) %>%
  setNames(c("variable"))

